# Copie ce fichier en ".env" puis adapte les valeurs (le fichier .env n'est jamais versionné)
PORT=8000
MONGO_URL=mongodb://localhost:27017/motocaz
# Secret de signature des tokens de connexion : génère-en un avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secret-code-secret-site-1234
# Adresse du site (CORS). Plusieurs origines possibles, séparées par des virgules.
CORS_ORIGIN=http://localhost:5173
